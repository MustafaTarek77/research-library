# Copy to .env. Startup scripts and Python commands read this file automatically.
# Relative paths resolve against the project directory. Shell exports take precedence.

# --- Library paths: change papers/output later when Google Drive is connected ---
# WSL also accepts Windows paths, e.g. 'C:\Users\name\My Drive\ResearchLibrary\papers'.
# Use single quotes around paths with backslashes, or use forward slashes.
PAPERS_DIR="./ResearchLibrary/papers"
OUTPUT_DIR="./ResearchLibrary/output"
# Application state must stay OUTSIDE the Drive-synced ResearchLibrary folder.
DATABASE_PATH="./data/papers.db"
WORK_DIR="./data"

# --- Logging and input discovery ---
LOG_LEVEL=INFO
LOG_FILE="./logs/pipeline.log"
FILE_STABILITY_SECONDS=10

# --- Local model requests ---
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen2.5:1.5b
LLM_CONTEXT=32768
LLM_THREADS=8
LLM_MAX_OUTPUT_TOKENS=512
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_KEEP_ALIVE=5m
LLM_NUM_GPU=0
LLM_TIMEOUT_SECONDS=900
LLM_PROGRESS_SECONDS=15

# --- Ollama server: keep the address consistent with OLLAMA_BASE_URL ---
OLLAMA_HOST=127.0.0.1:11435
OLLAMA_MODELS="./.cache/ollama"
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CONTEXT_LENGTH=32768
CUDA_VISIBLE_DEVICES=-1
ROCR_VISIBLE_DEVICES=-1
OLLAMA_VULKAN=false
OLLAMA_NO_CLOUD=true

# --- Airflow standalone ---
AIRFLOW_HOME="./.airflow"
AIRFLOW__CORE__DAGS_FOLDER="./dags"
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__PARALLELISM=1
AIRFLOW__CORE__DEFAULT_TIMEZONE=UTC
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW__API__HOST=127.0.0.1
AIRFLOW__API__WORKERS=1
AIRFLOW__DAG_PROCESSOR__PARSING_PROCESSES=1

# --- DAG scheduling and limits ---
PIPELINE_SCHEDULE="*/5 * * * *"
PIPELINE_MAX_ACTIVE_RUNS=1
PIPELINE_MAX_ACTIVE_TASKS=1
PIPELINE_RETRY_DELAY_SECONDS=30
# Allow enough time for two LLM requests (one invalid-JSON retry).
PIPELINE_EXTRACTION_TIMEOUT_MINUTES=35

# --- Discord: paste your private webhook URL here, then enable delivery ---
# No messages are sent until you enable this and configure the URL.
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=""

# --- Google Drive via rclone ---
# false: use local folders or Google Drive for desktop. true: run rclone transfers.
DRIVE_SYNC_ENABLED=false
DRIVE_SYNC_TIMEOUT_SECONDS=300
RCLONE_BINARY=rclone
# Browser authorization stores tokens in this Git-ignored local config.
RCLONE_CONFIG="./data/rclone/rclone.conf"
RCLONE_REMOTE="gdrive:ResearchLibrary"
RCLONE_CONFIG_GDRIVE_CLIENT_ID=""
RCLONE_CONFIG_GDRIVE_CLIENT_SECRET=""
